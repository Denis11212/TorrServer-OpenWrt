#!/bin/sh /etc/rc.common
START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/torrserver
TS_USER="torrserver"
TS_GROUP="torrserver"

_ts_add_ip() {
    procd_append_param command --ip "$1"
}

_ts_prepare_dir() {
    local dirpath="$1"

    if [ -L "$dirpath" ]; then
        logger -t torrserver "Error: $dirpath is a symbolic link. Refusing to start."
        return 1
    fi

    if [ -e "$dirpath" ] && [ ! -d "$dirpath" ]; then
        logger -t torrserver "Error: $dirpath exists but is not a directory."
        return 1
    fi

    if [ ! -d "$dirpath" ]; then
        mkdir -p "$dirpath" || {
            logger -t torrserver "Error: failed to create directory $dirpath"
            return 1
        }
        chown "$TS_USER:$TS_GROUP" "$dirpath" || {
            logger -t torrserver "Error: failed to chown $dirpath to $TS_USER:$TS_GROUP"
            return 1
        }
        chmod 750 "$dirpath" || {
            logger -t torrserver "Error: failed to chmod $dirpath"
            return 1
        }
    fi

    return 0
}

start_service() {
    local cfg="torrserver"
    config_load "$cfg"

    logger -t torrserver "=== TORRSERVER START ATTEMPT $(date +%s) ==="

    if [ ! -x "$PROG" ]; then
        logger -t torrserver "Error: binary not found or not executable: $PROG"
        return 1
    fi

    if ! id "$TS_USER" >/dev/null 2>&1; then
        logger -t torrserver "Error: user $TS_USER does not exist"
        return 1
    fi

    if ! grep -q "^${TS_GROUP}:" /etc/group; then
        logger -t torrserver "Error: group $TS_GROUP does not exist"
        return 1
    fi

    local global_cfg="global"

    config_get port "$global_cfg" port ""
    config_get_bool ssl "$global_cfg" ssl 0
    config_get sslport "$global_cfg" sslport ""
    config_get sslcert "$global_cfg" sslcert ""
    config_get sslkey "$global_cfg" sslkey ""
    config_get_bool forcehttps "$global_cfg" forcehttps 0
    config_get path "$global_cfg" path ""
    config_get_bool enable_logfile "$global_cfg" enable_logfile 0
    config_get logpath "$global_cfg" logpath ""
    config_get_bool enable_weblogfile "$global_cfg" enable_weblogfile 0
    config_get weblogpath "$global_cfg" weblogpath ""
    config_get_bool enable_telegram "$global_cfg" enable_telegram 0
    config_get tgtoken "$global_cfg" tgtoken ""
    config_get_bool rdb "$global_cfg" rdb 0
    config_get_bool httpauth "$global_cfg" httpauth 0
    config_get_bool dontkill "$global_cfg" dontkill 0
    config_get torrentsdir "$global_cfg" torrentsdir ""
    config_get torrentaddr "$global_cfg" torrentaddr ""
    config_get pubipv4 "$global_cfg" pubipv4 ""
    config_get pubipv6 "$global_cfg" pubipv6 ""
    config_get_bool searchwa "$global_cfg" searchwa 0
    config_get maxsize "$global_cfg" maxsize ""
    config_get fuse "$global_cfg" fuse ""
    config_get_bool webdav "$global_cfg" webdav 0
    config_get proxyurl "$global_cfg" proxyurl ""
    config_get proxymode "$global_cfg" proxymode ""
    config_get_bool respawn "$global_cfg" respawn 0
    config_get respawn_threshold "$global_cfg" respawn_threshold 3600
    config_get respawn_timeout "$global_cfg" respawn_timeout 5
    config_get respawn_retry "$global_cfg" respawn_retry 3
    config_get_bool log_stdout "$global_cfg" stdout 1
    config_get_bool log_stderr "$global_cfg" stderr 1
    config_get term_timeout "$global_cfg" term_timeout 15

    [ -z "$path" ] && path="/var/etc/torrserver"
    _ts_prepare_dir "$path" || return 1

    if [ "$ssl" = "1" ]; then
        if [ -n "$sslcert" ] && [ -z "$sslkey" ]; then
            logger -t torrserver -p daemon.warning "Warning: sslcert is set but sslkey is empty. Both will be ignored, self-signed certificate will be generated."
        elif [ -z "$sslcert" ] && [ -n "$sslkey" ]; then
            logger -t torrserver -p daemon.warning "Warning: sslkey is set but sslcert is empty. Both will be ignored, self-signed certificate will be generated."
        fi
    fi

    if [ "$enable_logfile" = "1" ] && [ -n "$logpath" ]; then
        _ts_prepare_dir "$(dirname "$logpath")" || return 1
    fi

    if [ "$enable_weblogfile" = "1" ] && [ -n "$weblogpath" ]; then
        _ts_prepare_dir "$(dirname "$weblogpath")" || return 1
    fi

    if [ -n "$torrentsdir" ]; then
        _ts_prepare_dir "$torrentsdir" || return 1
    fi

    if [ -n "$fuse" ]; then
        _ts_prepare_dir "$fuse" || return 1
    fi

    procd_open_instance
    procd_set_param command "$PROG"

    procd_append_param command --path "$path"

    [ -n "$port" ] && procd_append_param command --port "$port"
    config_list_foreach "$global_cfg" ip _ts_add_ip
    [ "$ssl" = "1" ] && procd_append_param command --ssl
    [ -n "$sslport" ] && procd_append_param command --sslport "$sslport"
    [ -n "$sslcert" ] && procd_append_param command --sslcert "$sslcert"
    [ -n "$sslkey" ] && procd_append_param command --sslkey "$sslkey"
    [ "$forcehttps" = "1" ] && procd_append_param command --force-https
    [ "$enable_logfile" = "1" ] && [ -n "$logpath" ] && procd_append_param command --logpath "$logpath"
    [ "$enable_weblogfile" = "1" ] && [ -n "$weblogpath" ] && procd_append_param command --weblogpath "$weblogpath"
    [ "$rdb" = "1" ] && procd_append_param command --rdb
    [ "$httpauth" = "1" ] && procd_append_param command --httpauth
    [ "$dontkill" = "1" ] && procd_append_param command --dontkill
    [ -n "$torrentsdir" ] && procd_append_param command --torrentsdir "$torrentsdir"
    [ -n "$torrentaddr" ] && procd_append_param command --torrentaddr "$torrentaddr"
    [ -n "$pubipv4" ] && procd_append_param command --pubipv4 "$pubipv4"
    [ -n "$pubipv6" ] && procd_append_param command --pubipv6 "$pubipv6"
    [ "$searchwa" = "1" ] && procd_append_param command --searchwa
    [ -n "$maxsize" ] && procd_append_param command --maxsize "$maxsize"
    [ "$enable_telegram" = "1" ] && [ -n "$tgtoken" ] && procd_append_param command --tgtoken "$tgtoken"
    [ -n "$fuse" ] && procd_append_param command --fuse "$fuse"
    [ "$webdav" = "1" ] && procd_append_param command --webdav
    [ -n "$proxyurl" ] && procd_append_param command --proxyurl "$proxyurl"
    [ -n "$proxymode" ] && procd_append_param command --proxymode "$proxymode"

    procd_set_param user "$TS_USER"
    procd_set_param group "$TS_GROUP"

    procd_set_param stdout "$log_stdout"
    procd_set_param stderr "$log_stderr"
    procd_set_param term_timeout "$term_timeout"

    if [ "$respawn" = "1" ]; then
        procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
    fi

    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "torrserver"
}
