msgid "Network & Ports"
msgstr "Сеть и порты"

msgid "Bind IP addresses"
msgstr "Привязка IP-адресов"

msgid "Web server bind addresses (repeatable). Default is empty, which binds to all interfaces."
msgstr "Адреса привязки веб-сервера (повторяемое поле). По умолчанию пусто, что означает привязку ко всем интерфейсам."

msgid "HTTP web server port"
msgstr "Порт HTTP веб-сервера"

msgid "Port for the HTTP web server (default: 8090). This is the main port for accessing the TorrServer web interface and API when SSL is disabled."
msgstr "Порт для HTTP веб-сервера (по умолчанию: 8090). Это основной порт для доступа к веб-интерфейсу и API TorrServer, когда SSL отключен."

msgid "Port must be between 1 and 65535"
msgstr "Порт должен быть в диапазоне от 1 до 65535"

msgid "Enable HTTPS for web server"
msgstr "Включить HTTPS для веб-сервера"

msgid "Enables HTTPS for the web server. When enabled, TorrServer will listen on both HTTP and HTTPS ports simultaneously."
msgstr "Включает HTTPS для веб-сервера. При включении TorrServer будет слушать одновременно и HTTP, и HTTPS порты."

msgid "HTTPS web server port"
msgstr "Порт HTTPS веб-сервера"

msgid "Port for the HTTPS web server (default: 8091). If not set, will be taken from database (if stored previously) or the default will be used. Only active when HTTPS is enabled."
msgstr "Порт для HTTPS веб-сервера (по умолчанию: 8091). Если не задан, будет взят из базы данных (если ранее сохранён) или использован по умолчанию. Активен только при включённом HTTPS."

msgid "Path to SSL certificate file"
msgstr "Путь к файлу SSL-сертификата"

msgid "Path to the SSL certificate file. If not set, will be taken from database (if stored previously) or a default self-signed certificate/key will be generated automatically."
msgstr "Путь к файлу SSL-сертификата. Если не задан, будет взят из базы данных (если ранее сохранён) или автоматически сгенерирован самоподписанный сертификат/ключ по умолчанию."

msgid "Path to SSL key file"
msgstr "Путь к файлу SSL-ключа"

msgid "Path to the SSL private key file. If not set, will be taken from database (if stored previously) or a default self-signed certificate/key will be generated automatically."
msgstr "Путь к файлу приватного SSL-ключа. Если не задан, будет взят из базы данных (если ранее сохранён) или автоматически сгенерирован самоподписанный сертификат/ключ по умолчанию."

msgid "Force HTTPS"
msgstr "Принудительный HTTPS"

msgid "With SSL enabled, the HTTP listener answers only with 307 Temporary Redirect to HTTPS. Requires SSL to be enabled."
msgstr "При включённом SSL HTTP-слушатель отвечает только редиректом 307 Temporary Redirect на HTTPS. Требует включения SSL."

msgid "Public IPv4 address"
msgstr "Публичный IPv4-адрес"

msgid "Set public IPv4 address for the server. Used when the server is behind NAT and needs to report its external IP address to peers."
msgstr "Задайте публичный IPv4-адрес сервера. Используется, когда сервер находится за NAT и должен сообщать пирам свой внешний IP-адрес."

msgid "Public IPv6 address"
msgstr "Публичный IPv6-адрес"

msgid "Set public IPv6 address for the server. Used when the server is behind NAT and needs to report its external IPv6 address to peers."
msgstr "Задайте публичный IPv6-адрес сервера. Используется, когда сервер находится за NAT и должен сообщать пирам свой внешний IPv6-адрес."

msgid "Proxy URL for BitTorrent traffic"
msgstr "URL прокси для BitTorrent-трафика"

msgid "Set proxy URL (HTTP, SOCKS4, SOCKS5, SOCKS5H). Example: socks5h://user:password@example.com:2080"
msgstr "Задайте URL прокси (HTTP, SOCKS4, SOCKS5, SOCKS5H). Пример: socks5h://user:password@example.com:2080"

msgid "Proxy mode"
msgstr "Режим прокси"

msgid "Set proxy mode for BitTorrent traffic."
msgstr "Задайте режим прокси для BitTorrent-трафика."

msgid "Tracker only (default)"
msgstr "Только трекер (по умолчанию)"

msgid "Peers only"
msgstr "Только пиры"

msgid "Full (all traffic)"
msgstr "Полный (весь трафик)"

