msgid "Backup archives created via \"Create Backup\" feature"
msgstr "Архивы резервных копий, созданные через функцию \"Создать резервную копию\""

msgid "UCI configuration (ports, paths, flags, autostart settings)"
msgstr "UCI-конфигурация (порты, пути, флаги, настройки автозапуска)"

