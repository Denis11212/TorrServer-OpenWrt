msgid "Must be a whole number (0 or more)"
msgstr "Должно быть целое число (0 или больше)"

msgid "Must be http://, https://, socks4://, socks5:// or socks5h:// URL"
msgstr "Должен быть URL вида http://, https://, socks4://, socks5:// или socks5h://"

msgid "Format: [IP]:PORT, e.g. :32000 or 127.0.0.1:32768"
msgstr "Формат: [IP]:ПОРТ, например :32000 или 127.0.0.1:32768"

msgid "Invalid token format. Expected: 123456789:ABCdefGHI…"
msgstr "Неверный формат токена. Ожидается: 123456789:ABCdefGHI…"

