# ============================================================

msgid "Logging & Diagnostics"
msgstr "Логирование и диагностика"

msgid "Forward stdout to syslog"
msgstr "Перенаправлять stdout в syslog"

msgid "If enabled, standard output of the TorrServer process is captured by procd and forwarded to the system log. If disabled, stdout is discarded."
msgstr "Если включено, стандартный вывод процесса TorrServer захватывается procd и перенаправляется в системный лог. Если выключено, stdout отбрасывается."

msgid "Forward stderr to syslog"
msgstr "Перенаправлять stderr в syslog"

msgid "If enabled, standard error of the TorrServer process is captured by procd and forwarded to the system log. If disabled, stderr is discarded."
msgstr "Если включено, стандартная ошибка процесса TorrServer захватывается procd и перенаправляется в системный лог. Если выключено, stderr отбрасывается."

msgid "System Log (syslog)"
msgstr "Системный лог (syslog)"

msgid "View System Log (logread)"
msgstr "Просмотр системного лога (logread)"

msgid "Shows TorrServer entries from the system log (logread). Process output appears there only when at least one of the two options above is enabled (forwarding stdout/stderr to syslog). Messages from the init.d script are visible regardless of these options."
msgstr "Показывает записи TorrServer из системного лога (logread). Вывод процесса появляется там только когда включена хотя бы одна из двух опций выше (перенаправление stdout/stderr в syslog). Сообщения из init.d скрипта видны независимо от этих опций."

msgid "TorrServer System Log (logread)"
msgstr "Системный лог TorrServer (logread)"

msgid "Write server log to a separate file"
msgstr "Записывать лог сервера в отдельный файл"

msgid "If enabled, logs will be duplicated to the file specified below. Otherwise, they are only available via System Log (logread)."
msgstr "Если включено, логи будут дублироваться в файл, указанный ниже. В противном случае они доступны только через системный лог (logread)."

msgid "Server log file path"
msgstr "Путь к файлу лога сервера"

msgid "Absolute path to the log file. The parent directory will be created automatically with correct permissions. The file itself is created and written by TorrServer running as user"
msgstr "Абсолютный путь к файлу лога. Родительский каталог будет создан автоматически с правильными правами. Сам файл создаётся и пишется TorrServer, работающим от пользователя"

msgid "Path is required when file logging is enabled."
msgstr "Путь требуется, когда включено логирование в файл."

msgid "Write web access log to a separate file"
msgstr "Записывать лог веб-доступа в отдельный файл"

msgid "If enabled, web UI and API requests will be written to a separate file."
msgstr "Если включено, запросы веб-интерфейса и API будут записываться в отдельный файл."

msgid "Web access log file path"
msgstr "Путь к файлу лога веб-доступа"

msgid "Absolute path to the web requests log file."
msgstr "Абсолютный путь к файлу лога веб-запросов."

msgid "Path is required when web access logging is enabled."
msgstr "Путь требуется, когда включено логирование веб-доступа."

msgid "Service Logs"
msgstr "Логи службы"

msgid "View Server Log (Live Tail)"
msgstr "Просмотр лога сервера (Live Tail)"

msgid "Opens the log file with real-time updates (every second)."
msgstr "Открывает файл лога с обновлениями в реальном времени (каждую секунду)."

msgid "Log file path is not set."
msgstr "Путь к файлу лога не задан."

msgid "TorrServer Server Log - Live Tail"
msgstr "Лог сервера TorrServer — Live Tail"

msgid "Web Access Logs"
