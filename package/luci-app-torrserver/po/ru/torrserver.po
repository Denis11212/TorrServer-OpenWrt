msgstr "Неверный формат токена. Ожидаемый формат: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

msgid "Absolute path with .pem, .crt, .cer, .key, .der, .p12 or .pfx extension required"
msgstr "Требуется абсолютный путь с расширением .pem, .crt, .cer, .key, .der, .p12 или .pfx"

msgid "Must be an absolute path (starting with /)"
msgstr "Должен быть абсолютный путь (начинающийся с /)"

