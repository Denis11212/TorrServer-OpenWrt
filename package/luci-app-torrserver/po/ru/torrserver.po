msgstr "Редактирование accs.db как обычного текста JSON. Формат: <code>{\"login\":\"password\"}</code>. Для продвинутых пользователей."

msgid "Edit accs.db"
msgstr "Редактировать accs.db"

msgid "WARNING: This file stores authentication credentials in plain text JSON. Format: {\"login\":\"password\"}. Restart TorrServer after editing."
msgstr "ВНИМАНИЕ: Этот файл хранит учётные данные в открытом JSON-формате. Формат: {\"login\":\"password\"}. Перезапустите TorrServer после редактирования."

msgid "Allow search without authentication"
msgstr "Разрешить поиск без аутентификации"

msgid "When enabled, allows search requests (including Torznab searches) without requiring authentication, even when HTTP authentication is enabled for other operations."
msgstr "При включении разрешает поисковые запросы (включая Torznab) без аутентификации, даже если HTTP-аутентификация включена для других операций."

